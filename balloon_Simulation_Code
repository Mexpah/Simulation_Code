# --- 📊 پیاده‌سازی کامل دکمه آنالیز کلی روی ویدیوهای علامت‌خورده 📊 ---
def calculate_global_analysis(event):
    print("📈 Extracting and calculating exact physical values from selected videos...")
    
    headers = ["Video", "Balloon Mass (g)", "Linear Density (g/m)", "Initial y(0) (m)", "1st Half-Period (s)"]
    table_rows = []
    
    for i in range(10):
        v_name = f"Video {i+1}"
        if global_selection_states[i]:  # فقط ویدیوهایی که چک‌باکس آن‌ها علامت خورده است
            if v_name in video_cache:
                params = video_cache[v_name]
                omega_sq, gamma, alpha1, alpha2, yinit, toff, yeq = params
                L0 = video_offsets.get(v_name, 0.3)
                
                # استخراج جرم واقعی بادکنک بر اساس مدل جرم متغیر طناب آزمایشگاه
                m1 = MU_DENSITY / gamma if gamma > 0.001 else float('inf')
                m_balloon_g = (m1 - MU_DENSITY * L0) * 1000
                
                # محاسبه دقیق زمان نیم‌تناوب اول به روش عددی
                t_half = compute_half_period(omega_sq, gamma, alpha1, alpha2, yinit, tf)
                t_half_str = f"{t_half:.3f}" if t_half is not None else "N/A"
                
                table_rows.append([
                    f"Video {i+1}",
                    f"{m_balloon_g:.2f}" if m1 != float('inf') else "N/A",
                    f"{MU_DENSITY * 1000:.2f}",
                    f"{yinit:.3f}",
                    t_half_str
                ])
            else:
                print(f"⚠️ {v_name} انتخاب شده ولی دیتای فیت شده ندارد. نادیده گرفته شد.")
                
    if not table_rows:
        print("❌ هیچ ویدیوی فیت‌شده‌ای در چک‌باکس‌ها انتخاب نشده است!")
        return

    # نمایش نتایج استخراج شده در قالب یک جدول مجزا و شیک برای گزارش کار
    fig_global, ax_global = plt.subplots(figsize=(10, 4.5))
    ax_global.axis('off')
    fig_global.suptitle("Global Parameters Extraction Dashboard", fontsize=13, weight='bold', y=0.95)
    
    all_table_data = [headers] + table_rows
    tab = ax_global.table(cellText=all_table_data, loc='center', cellLoc='center', 
                          colWidths=[0.12, 0.22, 0.24, 0.20, 0.22])
    tab.auto_set_font_size(False)
    tab.set_fontsize(10)
    
    # رنگ‌آمیزی هدر جدول برای خوانایی عالی
    for col_idx in range(len(headers)):
        cell = tab[(0, col_idx)]
        cell.set_facecolor('#1f77b4')
        cell.get_text().set_color('white')
        cell.get_text().set_weight('bold')
        
    plt.tight_layout()
    plt.show()

ax_btn_glob = plt.axes([0.02, 0.12, 0.18, 0.04])
