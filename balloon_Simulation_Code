# --- Report Analysis Function ---
def analyze_current_fit(event):
    current_vid = radio.value_selected
    if current_vid not in video_cache:
        print("⚠️ Please fit the current video first.")
        return
        
    params = video_cache[current_vid]
    gamma = params[1]
    L0 = video_offsets.get(current_vid, 0.3) 
    
    m1 = MU_DENSITY / gamma if gamma > 0.001 else 0.0
    balloon_mass = (m1 - (MU_DENSITY * L0)) * 1000
    
    table_data = [
        ["Parameter", "Calculated Value"],
        ["Active Video", str(current_vid)],
        ["Omega Squared (w^2)", f"{params[0]:.4f}"],
        ["Gamma", f"{gamma:.4f}"],
        ["Initial Position y(0)", f"{params[4]:.3f} m"],
        ["Balloon Net Mass (m)", f"{balloon_mass:.2f} g"]
    ]
    
    fig_pop, ax_pop = plt.subplots(figsize=(6, 3.5))
    ax_pop.axis('off')
    ax_pop.set_title(f"Experimental Report - {current_vid}", fontsize=12, weight='bold', pad=10)
    ax_pop.table(cellText=table_data, loc='center', cellLoc='center', colWidths=[0.45, 0.45])
    plt.tight_layout()
    plt.show()

