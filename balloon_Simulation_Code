        except Exception as e:
            print(f"⚠️ فایل کش لود نشد: {e}")

# 1. ODE System - مدل فیزیکی رفت و برگشت
def ode_system_y(t, state, omega_sq, gamma, alpha1, alpha2):
    y, v = state
    denom = 1.0 + gamma * y
    if denom < 0.05: denom = 0.05
        
    # درگ همیشه مخالف جهت سرعت حرکت اعمال می‌شود
    if v > 0:
        acc = (-omega_sq * y - alpha1 * (v ** 2)) / denom
    else:
        acc = (-omega_sq * y + alpha2 * (v ** 2)) / denom
        
    return [v, acc]

# --- تابع کمکی محاسباتی برای یافتن زمان دقیق نیم‌تناوب اول ---
def compute_half_period(omega_sq, gamma, alpha1, alpha2, yinit, max_t):
    t_eval = np.linspace(0.0, max_t, 4000)
    sol = solve_ivp(ode_system_y, [0.0, max_t], [yinit, 0.0], 
                    args=(omega_sq, gamma, alpha1, alpha2), 
                    t_eval=t_eval, method='RK45')
    if not sol.success:
        return None
    v = sol.y[1]
    t = sol.t
    
    # پیدا کردن اولین جایی که سرعت بعد از شروع حرکت صفر می‌شود (تغییر علامت می‌دهد)
    idx = np.where(t > 0.08)[0]
    for i in idx[:-1]:
        if v[i] * v[i+1] <= 0:
            # درون‌یابی خطی برای یافتن زمان دقیق ریشه سرعت
            t_zero = t[i] - v[i] * (t[i+1] - t[i]) / (v[i+1] - v[i])
            return t_zero
    return None

